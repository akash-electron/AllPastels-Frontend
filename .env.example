# Copy this file to `.env.local` for local development.
#
# Only public browser configuration belongs in NEXT_PUBLIC_* variables.
# Never add MongoDB, SMTP, JWT or other private credentials here.

# Express backend origin (no trailing slash, no /api suffix).
NEXT_PUBLIC_API_URL=http://localhost:5000

# Public OAuth client id for "Sign in with Google" (same value as backend GOOGLE_CLIENT_ID).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
